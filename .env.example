# Copy this file to .env before running Docker Compose.
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_password
POSTGRES_DB=stock_predictions
POSTGRES_PORT=5432

AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.2
AIRFLOW__API_AUTH__JWT_SECRET=change-me-for-local-dev-jwt-secret
AIRFLOW__API_AUTH__JWT_ISSUER=stock-predictions-local
FERNET_KEY=
_PIP_ADDITIONAL_REQUIREMENTS=
AIRFLOW_POSTGRES_USER=airflow_user
AIRFLOW_POSTGRES_PASSWORD=airflow_password
AIRFLOW_POSTGRES_DB=airflow_metadata

METABASE_IMAGE_NAME=metabase/metabase:v0.62.3.x
METABASE_PORT=3000
METABASE_POSTGRES_USER=metabase_user
METABASE_POSTGRES_PASSWORD=metabase_password
METABASE_POSTGRES_DB=metabase_application_metadata

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
